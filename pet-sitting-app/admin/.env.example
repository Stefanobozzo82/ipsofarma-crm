# Copia in .env e compila con lo stesso progetto Supabase di backend/.env —
# necessario per lo sviluppo locale. Non serve in produzione su Render (vedi
# il fallback in src/lib/env.ts): senza, il pannello mostra solo un errore di
# login gestito, non crasha.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=changeme

# Backend Express — in locale punta al backend locale; in produzione ha un
# fallback al backend già deployato su Render (vedi src/lib/env.ts), quindi
# non è obbligatorio impostarla su Render a meno di puntare a un backend diverso.
VITE_API_URL=http://localhost:4000/api/v1

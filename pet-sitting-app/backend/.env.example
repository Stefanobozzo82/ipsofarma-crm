# Copia questo file in .env e compila con i valori del tuo progetto Supabase
# (Project Settings → API). Non committare mai .env.

PORT=4000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme

# Origini consentite per le richieste CORS — lista separata da virgole, utile
# per far girare mobile (Expo, 8081) e admin (Vite, 5173) insieme contro lo
# stesso backend in sviluppo.
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# Stripe Connect — opzionali: senza queste il server si avvia comunque, ma
# le rotte di pagamento (onboarding, prenotazioni/pay, payout, webhook)
# rispondono 503 "stripe_not_configured" finché non le imposti.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# URL di ritorno dell'onboarding Connect Express (placeholder web finché non
# c'è un deep link mobile — Fase 5/6).
# STRIPE_CONNECT_REFRESH_URL=https://fido.app/stripe/onboarding/refresh
# STRIPE_CONNECT_RETURN_URL=https://fido.app/stripe/onboarding/complete

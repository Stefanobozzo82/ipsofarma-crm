# Copia questo file in .env e compila con i valori del tuo progetto Supabase
# (Project Settings → API). Non committare mai .env.

PORT=4000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme

# Origine consentita per le richieste CORS (app mobile in dev / admin panel).
CORS_ORIGIN=http://localhost:8081

# --- Fase 4 (pagamenti) — non ancora usate dal codice attuale ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

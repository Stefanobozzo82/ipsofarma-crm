# Copia in .env e compila. Le variabili EXPO_PUBLIC_* sono incorporate nel
# bundle a build time e finiscono nell'app installata: non mettere qui
# segreti (service role, chiavi Stripe segrete) — solo chiavi pubbliche.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=changeme

# URL del backend Express (Fasi 2-4). In locale con simulatore iOS o Expo
# web va bene localhost; su device fisico/Android emulator serve l'IP della
# macchina in rete locale (es. http://192.168.1.10:4000).
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

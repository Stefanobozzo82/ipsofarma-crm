# Copia in .env.local (o .env) e compila per sviluppo locale contro il
# backend locale — non necessario per usare il sito contro il backend già
# deployato (vedi il fallback in src/lib/env.ts). Le variabili VITE_* sono
# incorporate nel bundle a build time: non mettere qui segreti.

VITE_API_URL=http://localhost:4000/api/v1

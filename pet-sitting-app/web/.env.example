# Copia in .env.local (o .env) e compila per sviluppo locale contro il
# backend locale — non necessario per usare il sito contro il backend già
# deployato (vedi il fallback in src/lib/env.ts). Le variabili VITE_* sono
# incorporate nel bundle a build time: non mettere qui segreti.

VITE_API_URL=http://localhost:4000/api/v1

# Stesso progetto Supabase di backend/mobile/admin — copia i valori da lì
# (SUPABASE_URL / SUPABASE_ANON_KEY nel loro .env). L'anon key è pensata
# per stare nel client, protetta da RLS: non è un segreto da nascondere.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=changeme

# Chiave pubblicabile Stripe (pk_...), stessa usata da mobile
# (EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY) — safe da esporre lato client, serve
# al pulsante "Paga ora" nella pagina di stato prenotazione.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_changeme

# Copia questo file in .env.local (dentro saas/) e riempi con i valori veri
# presi da Supabase → Project Settings → API. Non committare mai .env.local:
# è già escluso dal git del resto del repo tramite .gitignore in questa cartella.

# Project URL, es: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# anon public key — può stare nel frontend, è protetta dalle policy RLS
SUPABASE_ANON_KEY=

# service_role key — SOLO lato server (Edge Functions), bypassa la RLS.
# Se finisce nel frontend o su GitHub, chiunque legge tutti i dati di tutte
# le aziende clienti. Va trattata come la password di un amministratore.
SUPABASE_SERVICE_ROLE_KEY=

# Edge Functions browser CORS: origini esatte separate da virgola, senza slash
# finale o percorsi. Configurare separatamente in sviluppo, staging e produzione.
# Esempio SOLO locale: http://localhost:8080,http://127.0.0.1:8080
# Se vuoto, le richieste browser con Origin sono rifiutate (fail closed).
# Impostare nei secret/env delle funzioni PRIMA di distribuire il nuovo codice.
EDGE_ALLOWED_ORIGINS=

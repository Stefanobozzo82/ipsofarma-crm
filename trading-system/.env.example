# Copia questo file in `.env` e compila SOLO le variabili che ti servono per
# i moduli che stai effettivamente usando. Nessun valore qui è una chiave
# reale: sono tutti placeholder vuoti/commentati.

# --- Generale --------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database: default SQLite locale in data/trading_system.db.
# Decommenta e imposta DATABASE_URL per usare PostgreSQL invece.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/trading_system

# --- Modulo 1: Data ingestion (opzionali, non richieste per yfinance/ccxt pubblico) ---
# ALPHAVANTAGE_API_KEY=
# POLYGON_API_KEY=

# --- Modulo 6: Execution — azioni/ETF (richieste solo quando attiviamo l'esecuzione) ---
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper trading di default

# --- Modulo 6: Execution — crypto (richieste solo per ordini reali; NON servono per i dati) ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=

# --- Modulo 6: interruttore esplicito per il trading con denaro reale -----
# Deve restare "false" finché non decidiamo insieme di attivare l'execution
# live. Il modulo execution/live/ (non ancora implementato) rifiuterà di
# partire se questa variabile non è "true" ESPLICITAMENTE.
# LIVE_TRADING_ENABLED=false

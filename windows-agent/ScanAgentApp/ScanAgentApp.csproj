<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (non Exe): niente finestra nera della console quando avviato
         su Windows con un doppio clic o all'accesso — sostituisce la
         combinazione scan-agent.ps1 + run-scan-agent-hidden.vbs con UN solo
         file. Sugli altri sistemi operativi (qui, in fase di sviluppo/test)
         non ha alcun effetto: si comporta come una normale app console. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IpsofarmaScanAgent</AssemblyName>
    <RootNamespace>IpsofarmaScanAgent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Valori di default per "dotnet publish" senza altri parametri, così
         il comando di build resta uno solo — vedi windows-agent/README-build.md.
         Un solo file .exe autosufficiente: include il runtime .NET, non
         richiede nulla di preinstallato sul PC del cliente. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- NIENTE TRIMMING: provato (per stare sotto i 30 MB dell'invio
         diretto), ma il trimming disattiva di default il supporto COM
         "built-in" di .NET — InvokeScan() falliva in campo con "Built-in
         COM has been disabled via a feature switch" proprio nel creare
         l'oggetto WIA.CommonDialog, l'UNICA cosa per cui questo programma
         usa COM. Riabilitarlo (BuiltInComInteropSupport=true) toglie
         l'errore esplicito ma il linker stesso avvisa che il supporto COM
         "non è compatibile col trimming" in modo garantito — un rischio
         non verificabile da qui (su Linux GetTypeFromProgID torna null
         PRIMA di toccare il codice COM vero, quindi non c'è modo di
         collaudare qui se il trimming toglie anche solo un pezzo che
         serve). Meglio un file più pesante ma sicuro che uno leggero con
         un rischio non verificato. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
